# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Values come from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic).
# Production: reCAPTCHA Enterprise site key registered for your hosting domain.
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
# Local dev only: "true" prints a debug token in the browser console (register it
# under Security > App Check > Apps > Manage debug tokens), or paste a registered token.
# Ignored in production builds.
VITE_APPCHECK_DEBUG_TOKEN=true

# Optional: override the cloud model used for stage 2.
VITE_CLOUD_MODEL=
